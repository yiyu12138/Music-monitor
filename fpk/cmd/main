#!/bin/bash
# Music Monitor · 原生应用生命周期脚本
# 直接用飞牛自带的 python312 运行时启动 uvicorn，不使用 Docker。

set -u

PKG_VAR="${TRIM_PKGVAR:-/var/apps/music-monitor/var}"
APP_DIR="${TRIM_APPDEST:-/var/apps/music-monitor/target}"
PY="${FNOS_PYTHON:-/var/apps/python312/target/bin/python3}"
PORT="${wizard_port:-6696}"
TZ_VAL="${wizard_tz:-Asia/Shanghai}"
DATA_DIR="${wizard_data_dir:-/var/apps/music-monitor/var/data}"
RUN_DIR="${PKG_VAR}/run"
PID_FILE="${PKG_VAR}/app.pid"
LOG_FILE="${PKG_VAR}/app.log"

log() { printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "${LOG_FILE}" 2>/dev/null || true; }
fail() {
    printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>/dev/null || true
    log "失败: $1"
    exit 1
}

pid_running() {
    [ -f "${PID_FILE}" ] || return 1
    local p
    p="$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
    [ -n "${p}" ] && kill -0 "${p}" 2>/dev/null
}

port_ready() {
    curl -fsS -o /dev/null --max-time 3 "http://127.0.0.1:${PORT}/" 2>/dev/null
}

# 端口是否已被其它程序占用（避免启动后 uvicorn 绑定失败、应用被系统判定为「停用」）
port_in_use() {
    if command -v ss >/dev/null 2>&1; then
        if ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${PORT}$"; then
            return 0
        fi
        return 1
    fi
    local hex
    hex="$(printf '%04X' "${PORT}")"
    awk 'NR>1 {print $2}' /proc/net/tcp /proc/net/tcp6 2>/dev/null | grep -qiE "[:.]${hex}$"
}

# 占用该端口的 Docker 容器名（用于给出更明确的提示）
port_holders() {
    command -v docker >/dev/null 2>&1 || return 0
    docker ps --format '{{.Names}}' 2>/dev/null | while read -r name; do
        [ -n "${name}" ] || continue
        if docker port "${name}" 2>/dev/null | grep -qE ":${PORT}$"; then
            printf '%s ' "${name}"
        fi
    done
}

start_app() {
    [ -x "${PY}" ] || fail "未找到飞牛 Python 运行时 ${PY}，请先在应用中心安装 python312。"
    [ -f "${APP_DIR}/server/main.py" ] || fail "应用文件不完整，请重新安装。"
    pid_running && return 0

    # 端口被占用时直接给出可操作的原因，而不是启动后静默退出
    if port_in_use; then
        holders="$(port_holders)"
        msg="端口 ${PORT} 已被其它程序占用"
        if [ -n "${holders}" ]; then
            msg="${msg}（占用它的 Docker 容器：${holders}）"
        fi
        msg="${msg}，应用无法启动。请先停止占用的程序（例如 docker rm -f ${holders:-<容器名>} / sudo systemctl stop <服务>），或在飞牛「应用中心 → 音乐下载器 → 应用设置」里把访问端口改成其它端口后重试。"
        fail "${msg}"
    fi

    mkdir -p "${DATA_DIR}" "${RUN_DIR}/downloads" "${PKG_VAR}" 2>/dev/null || true
    # 应用以「当前目录/data」存放配置与登录态：把 data 软链到向导里的应用数据目录，
    # 这样用户选定的目录里直接就是 config.json、cookie、任务历史等文件
    ln -sfn "${DATA_DIR}" "${RUN_DIR}/data"
    ln -sfn "${APP_DIR}/server/templates" "${RUN_DIR}/templates"
    ln -sfn "${APP_DIR}/server/static" "${RUN_DIR}/static"

    log "启动: 端口 ${PORT}，数据目录 ${DATA_DIR}"
    (
        cd "${RUN_DIR}" || exit 1
        TZ="${TZ_VAL}" \
        PYTHONPATH="${APP_DIR}/server:${APP_DIR}/pylib" \
        PYTHONUNBUFFERED=1 \
        nohup "${PY}" -m uvicorn main:app --host 0.0.0.0 --port "${PORT}" >>"${LOG_FILE}" 2>&1 &
        echo $! > "${PID_FILE}"
    )

    for _ in $(seq 1 45); do
        # 先确认是我们自己的进程活着，再看端口（否则会被别的程序占用的端口骗过去）
        if ! pid_running; then
            tail -n 20 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>/dev/null || true
            fail "进程启动后立即退出，请查看 ${LOG_FILE}"
        fi
        if port_ready && pid_running; then
            log "启动成功"
            return 0
        fi
        sleep 1
    done
    tail -n 20 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>/dev/null || true
    fail "启动超时（45 秒内端口 ${PORT} 未就绪）"
}

stop_app() {
    if ! pid_running; then
        rm -f "${PID_FILE}"
        return 0
    fi
    local p
    p="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    log "停止进程 ${p}"
    kill "${p}" 2>/dev/null || true
    for _ in $(seq 1 20); do
        kill -0 "${p}" 2>/dev/null || break
        sleep 1
    done
    kill -0 "${p}" 2>/dev/null && kill -9 "${p}" 2>/dev/null
    rm -f "${PID_FILE}"
    return 0
}

case "${1:-}" in
    start) start_app ;;
    stop)  stop_app ;;
    status)
        if pid_running && port_ready; then exit 0; else exit 3; fi
        ;;
    *) exit 1 ;;
esac

#!/bin/bash
# 用户在应用设置里改了端口/目录：写入配置并重启服务
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
PKG_VAR="${TRIM_PKGVAR:-/var/apps/music-monitor/var}"
PY="${FNOS_PYTHON:-/var/apps/python312/target/bin/python3}"
DATA_DIR="${wizard_data_dir:-/var/apps/music-monitor/var/data}"
MUSIC_DIR="${wizard_music_dir:-/vol1/1000/music}"
LOG="${PKG_VAR}/config.log"

mkdir -p "${DATA_DIR}/data" 2>/dev/null || true
"${PY}" "${HERE}/seed_config.py" "${DATA_DIR}" "${MUSIC_DIR}" >> "${LOG}" 2>&1 || true
"${HERE}/main" stop >> "${LOG}" 2>&1 || true
"${HERE}/main" start >> "${LOG}" 2>&1 || exit 1
exit 0

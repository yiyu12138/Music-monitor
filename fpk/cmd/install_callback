#!/bin/bash
# 安装后：初始化数据目录与配置
set -u
PKG_VAR="${TRIM_PKGVAR:-/var/apps/music-monitor/var}"
APP_DIR="${TRIM_APPDEST:-/var/apps/music-monitor/target}"
PY="${FNOS_PYTHON:-/var/apps/python312/target/bin/python3}"
DATA_DIR="${wizard_data_dir:-/var/apps/music-monitor/var/data}"
MUSIC_DIR="${wizard_music_dir:-/vol1/1000/music}"
LOG="${PKG_VAR}/install.log"

mkdir -p "${DATA_DIR}/data" "${PKG_VAR}" 2>/dev/null || true
mkdir -p "${MUSIC_DIR}" 2>/dev/null || echo "$(date) - 音乐目录不存在: ${MUSIC_DIR}" >> "${LOG}"
"${PY}" "$(dirname "$0")/seed_config.py" "${DATA_DIR}" "${MUSIC_DIR}" >> "${LOG}" 2>&1 || exit 1
echo "$(date) - 安装初始化完成（数据 ${DATA_DIR}，音乐 ${MUSIC_DIR}）" >> "${LOG}"
exit 0
